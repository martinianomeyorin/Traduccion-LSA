# Obligatoria para producción; la app genera una clave efímera en desarrollo.
SECRET_KEY=replace-with-a-long-random-secret

# Si se omite, se usa SQLite local (lsa.db).
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/lsa

# Ollama debe estar instalado, abierto y con el modelo descargado.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=180

CAMERA_INDEX=0
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=false
DATASET_DIR=./LSA
